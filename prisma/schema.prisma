datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DATA_ENTRY
  VIEWER
}

enum ScopeType {
  ALL
  RESTRICTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  OTHER
}

enum PaymentContext {
  ZAKAT
  SADAQAH
  GENERAL
  OTHER
}

enum DonationType {
  POOLED
  DESIGNATED
}

enum RecipientCategory {
  MEDICAL
  FOOD
  EDUCATION
  RENT
  EMERGENCY
  OTHER
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role
  scopeType      ScopeType
  active         Boolean        @default(true)
  tokenVersion   Int            @default(0)
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  donations      Donation[]     @relation("RecordedDonations")
  distributions  Distribution[] @relation("RecordedDistributions")
  userScopes     UserScope[]
}

model Donor {
  id          String      @id @default(uuid())
  name        String?
  isAnonymous Boolean     @default(false)
  phone       String?
  email       String?
  address     String?
  isRecurring Boolean     @default(false)
  notes       String?
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  donations   Donation[]
  userScopes  UserScope[]

  @@index([deletedAt])
}

model Recipient {
  id                  String            @id @default(uuid())
  name                String
  phone               String?
  address             String?
  category            RecipientCategory
  notes               String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  deletedAt           DateTime?
  distributions       Distribution[]
  designatedDonations Donation[]        @relation("DesignatedRecipient")
  userScopes          UserScope[]

  @@index([deletedAt])
}

model Donation {
  id                    String         @id @default(uuid())
  donorId               String?
  donor                 Donor?         @relation(fields: [donorId], references: [id])
  amount                Decimal        @db.Decimal(12, 2)
  date                  DateTime       @db.Date
  paymentMethod         PaymentMethod
  paymentContext        PaymentContext
  type                  DonationType
  designatedRecipientId String?
  designatedRecipient   Recipient?     @relation("DesignatedRecipient", fields: [designatedRecipientId], references: [id])
  notes                 String?
  recordedById          String
  recordedBy            User           @relation("RecordedDonations", fields: [recordedById], references: [id])
  createdAt             DateTime       @default(now())
  deletedAt             DateTime?
  distributions         Distribution[]

  @@index([donorId])
  @@index([designatedRecipientId])
  @@index([recordedById])
  @@index([date])
  @@index([deletedAt])
}

model Distribution {
  id           String    @id @default(uuid())
  recipientId  String
  recipient    Recipient @relation(fields: [recipientId], references: [id])
  amount       Decimal   @db.Decimal(12, 2)
  date         DateTime  @db.Date
  purpose      String
  donationId   String?
  donation     Donation? @relation(fields: [donationId], references: [id])
  notes        String?
  recordedById String
  recordedBy   User      @relation("RecordedDistributions", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([recipientId])
  @@index([donationId])
  @@index([recordedById])
  @@index([date])
  @@index([deletedAt])
}

model UserScope {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donorId     String?
  donor       Donor?     @relation(fields: [donorId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([donorId])
  @@index([recipientId])
}
