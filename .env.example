# Copy to .env and fill in real values for production

# Used directly when running outside Docker (e.g. `npx prisma migrate`).
# docker-compose.yml builds its own DATABASE_URL from the POSTGRES_* vars below.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hisab"

# Required by docker-compose.yml — pick a real password, not "hisab".
POSTGRES_USER="hisab"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="hisab"

# Generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

NODE_ENV="development"
