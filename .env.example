# This file is only consulted for non-Docker use (dev:local / npm test /
# prisma migrate dev) and to bootstrap the hisab_db/db_test Postgres
# containers' own credentials. Docker-based app runs (npm run dev, npm run
# start) instead fetch DATABASE_URL/AUTH_*/ADMIN_* from Infisical — see
# "Secrets (Infisical)" in README.md / AGENTS.md.

# Database — used by docker-compose to construct DATABASE_URL
# Host-side value (npm run dev:local / npm test / prisma migrate dev):
DATABASE_URL="postgresql://hisab:change-me@localhost:5432/hisab"
POSTGRES_USER="hisab"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="hisab"

# Auth (NextAuth v5)
AUTH_SECRET=""                                    # REQUIRED: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"                           # "true" for production behind reverse proxy

# Admin seed (used by prisma/seed.ts for initial admin user)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Node
NODE_ENV="development"

# Infisical (Docker flows only — export in your shell, not stored in .env)
# INFISICAL_CLIENT_ID="<machine-identity-client-id>"
# INFISICAL_CLIENT_SECRET="<machine-identity-client-secret>"
# INFISICAL_ENV="dev"                              # "prod" for docker-compose.yml
